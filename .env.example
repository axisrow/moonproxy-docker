# MoonProxy Environment Variables

# Секретный ключ для JWT токенов (обязательно измените в production)
MOONPROXY_SECRET_KEY=your-secret-key-change-this-to-something-secure

# Админ пароль для управления токенами (обязательно измените в production)
MOONPROXY_ADMIN_PASSWORD=admin123

# URL базы данных (по умолчанию SQLite)
MOONPROXY_DATABASE_URL=sqlite:///./data/moonproxy.db

# Уровень логирования
MOONPROXY_LOG_LEVEL=INFO

# Порт сервиса
MOONPROXY_PORT=8000

# Хост для привязки
MOONPROXY_HOST=0.0.0.0
